+static void human(long long b, char *out, size_t n) {
+    if (b >= 1024LL * 1024 * 1024) snprintf(out, n, "%.1f GB", b / 1073741824.0);
+    else if (b >= 1024LL * 1024) snprintf(out, n, "%.1f MB", b / 1048576.0);
+    else snprintf(out, n, "%lld KB", (b + 1023) / 1024);
+}
