+static void eas_screen(struct unified_tuner tuners[], int total) {
+    WINDOW *w = newwin(LINES, COLS, 0, 0);
+    keypad(w, TRUE);
+    wtimeout(w, 1000);
+    eas_config_t cfg;
+    eas_config_load(&cfg);
+    static eas_row_t rows[64];
+    int nrows = eas_build_rows(rows, 64, tuners, total, &cfg);
+    int sel = 0;
+    char msg[300] = "";
+
+    /* If something is already armed/running, say so up front */
+    eas_state_t st;
+    eas_state_read(&st);
+    if (st.alive) snprintf(msg, sizeof(msg), "A %s run is active. Press m to watch it.", !strcmp(st.mode, "test") ? "test" : "scheduled");
+
+    for (;;) {
+        eas_state_read(&st);
+        werase(w);
+        box(w, 0, 0);
+        int W = getmaxx(w), H = getmaxy(w);
+        wattron(w, A_BOLD);
+        mvwprintw(w, 0, 2, " %s v%s - EAS Capture Setup ", PROJECT_NAME, TUI_VERSION);
+        wattroff(w, A_BOLD);
+        char rl[300];
+        eas_runner_line(&st, rl, sizeof(rl));
+        if (st.alive) wattron(w, COLOR_PAIR(2) | A_BOLD);
+        mvwprintw(w, 1, 2, "%.*s", W - 4, rl);
+        if (st.alive) wattroff(w, COLOR_PAIR(2) | A_BOLD);
+
+        int y = 3;
+        wattron(w, A_UNDERLINE);
+        mvwprintw(w, y++, 2, "%-12s %-16s %-22s %-14s %-9s", "Tuner", "IP", "Tuned to now", "EAS channel", "Type");
+        wattroff(w, A_UNDERLINE);
+        int list_h = H - 19;
+        if (list_h < 3) list_h = 3;
+        int first = sel >= list_h ? sel - list_h + 1 : 0;
+        for (int i = first; i < nrows && i < first + list_h; i++) {
+            eas_cfg_tuner_t *t = eas_config_find(&cfg, rows[i].devid, rows[i].ip, rows[i].tuner);
+            const char *chan = (t && t->chan[0]) ? t->chan : "";
+            char label[24], now[40];
+            snprintf(label, sizeof(label), "%s-%d", rows[i].devid, rows[i].tuner);
+            if (rows[i].now_lock[0] && strcmp(rows[i].now_lock, "none"))
+                snprintf(now, sizeof(now), "%s", rows[i].now_ch);
+            else
+                snprintf(now, sizeof(now), "%s", rows[i].found ? "idle" : rows[i].now_ch);
+            if (i == sel) wattron(w, A_REVERSE);
+            mvwprintw(w, y, 2, "%-12s %-16s %-22.22s ", label, rows[i].ip, now);
+            if (chan[0]) wattron(w, A_BOLD);
+            wprintw(w, "%-14s", chan[0] ? chan : "-");
+            if (chan[0]) wattroff(w, A_BOLD);
+            wprintw(w, " %-9s", eas_chan_type(chan));
+            if (i == sel) wattroff(w, A_REVERSE);
+            y++;
+        }
+        if (!nrows) mvwprintw(w, y++, 2, "No HDHomeRun tuners found. Go back and press r to refresh, or i to add by IP.");
+        y = 4 + list_h;
+        mvwhline(w, y++, 1, ACS_HLINE, W - 2);
+        mvwprintw(w, y++, 2, "s Start: %-18s  e Stop: %-18s  g Segment: %d s", cfg.start, cfg.stop, cfg.seg);
+        mvwprintw(w, y++, 2, "f ATSC 3.0 format: %-9s  o Output: %.*s", cfg.fmt3 == EAS_FMT_DBG ? "debug" : "ALP-PCAP",
+                  W - 45 > 10 ? W - 45 : 10, cfg.outdir);
+        if (g_pause_services) {
+            mvwprintw(w, y++, 2, "p Pause services: %.*s", W - 22, cfg.pause_units[0] ? cfg.pause_units : "(none - d to detect)");
+            mvwprintw(w, y++, 2, "h Pause on: %-14s  b Pause lead: %d s   r Reports after: %-3s   l Test: %d min, %d s segments",
+                      cfg.pause_ssh[0] ? cfg.pause_ssh : "this machine", cfg.pause_lead, cfg.auto_render ? "yes" : "no",
+                      cfg.test_minutes, cfg.test_seg);
+        } else {
+            wattron(w, COLOR_PAIR(2) | A_BOLD);
+            mvwprintw(w, y++, 2, "%.*s", W - 4, "NOTE: Free each tuner you will use for the EAS test (RabbitEars bandscan, DVR, live viewing, etc.).");
+            wattroff(w, COLOR_PAIR(2) | A_BOLD);
+            mvwprintw(w, y++, 2, "r Reports after: %-3s   l Test: %d min, %d s segments   (start with --pause-services to stop/restart services here)",
+                      cfg.auto_render ? "yes" : "no", cfg.test_minutes, cfg.test_seg);
+        }
+        double need, freeg;
+        eas_config_estimate(&cfg, false, &need, &freeg);
+        if (freeg >= 0) {
+            bool low = freeg < need;
+            if (low) wattron(w, COLOR_PAIR(1) | A_BOLD);
+            mvwprintw(w, y++, 2, "  Scheduled run needs up to ~%.1f GB for %d tuner(s); %.1f GB free%s", need,
+                      eas_config_active_count(&cfg), freeg, low ? "  <-- NOT ENOUGH" : "");
+            if (low) wattroff(w, COLOR_PAIR(1) | A_BOLD);
+        }
+        {
+            int wport = 0;
+            char wdir[600], ip[64];
+            if (eas_web_status(&wport, wdir, sizeof(wdir)) > 0) {
+                eas_lan_ip(ip, sizeof(ip));
+                wattron(w, COLOR_PAIR(3));
+                mvwprintw(w, y++, 2, "w Web server: http://%s:%d/  (serving %.*s)", ip, wport, W - 60 > 10 ? W - 60 : 10, wdir);
+                wattroff(w, COLOR_PAIR(3));
+            } else {
+                mvwprintw(w, y++, 2, "w Web server: off (starts by itself when reports are made)");
+            }
+        }
+        mvwhline(w, y++, 1, ACS_HLINE, W - 2);
+        mvwprintw(w, y++, 2, "Up/Dn select  Enter set channel  u use what it's tuned to now  x clear  R refresh%s",
+                  g_pause_services ? "  d detect services" : "");
+        wattron(w, A_BOLD);
+        mvwprintw(w, y++, 2, "T  TEST RUN now (%d min)     A  ARM scheduled run     m  monitor     q  back", cfg.test_minutes);
+        wattroff(w, A_BOLD);
+        if (msg[0]) { wattron(w, A_REVERSE); mvwprintw(w, H - 2, 2, "%.*s", W - 4, msg); wattroff(w, A_REVERSE); }
+        wrefresh(w);
+
+        int ch = wgetch(w);
+        if (ch == ERR) continue;
+        if (ch == KEY_MOUSE) { MEVENT ev; getmouse(&ev); continue; }
+        msg[0] = '\0';
+        char buf[512];
+        bool changed = false;
+        eas_row_t *r = nrows ? &rows[sel] : NULL;
+
+        switch (ch) {
+        case KEY_UP: if (sel > 0) sel--; break;
+        case KEY_DOWN: if (sel < nrows - 1) sel++; break;
+        case 'q': case 27:
+            eas_config_save(&cfg);
+            delwin(w);
+            return;
+        case '\n': case '\r': case KEY_ENTER: case 'c': {
+            if (!r) break;
+            eas_cfg_tuner_t *t = eas_config_find(&cfg, r->devid, r->ip, r->tuner);
+            char lbl[120];
+            snprintf(lbl, sizeof(lbl), "Channel for %s-%d (27 = ATSC 1.0, 31p0 or 31p0p1 = ATSC 3.0, - = none)",
+                     r->devid, r->tuner);
+            if (!eas_prompt(w, lbl, t ? t->chan : "", buf, 48)) break;
+            if (!strcmp(buf, "-")) { if (t) t->chan[0] = '\0'; changed = true; break; }
+            eas_job_t j;
+            eas_job_init(&j);
+            char err[200];
+            int rc = eas_parse_channel_spec(buf, &j, err, sizeof(err));
+            eas_job_destroy(&j);
+            if (rc < 0) { snprintf(msg, sizeof(msg), "%s", err); break; }
+            t = eas_config_add(&cfg, r->devid, r->ip, r->tuner);
+            if (t) { snprintf(t->chan, sizeof(t->chan), "%s", buf); changed = true; }
+            if (sel < nrows - 1) sel++;
+            break;
+        }
+        case 'u': {
+            if (!r) break;
+            char spec[48];
+            eas_status_to_spec(r->now_ch, r->now_lock, spec, sizeof(spec));
+            if (!spec[0]) { snprintf(msg, sizeof(msg), "%s-%d isn't tuned to anything right now.", r->devid, r->tuner); break; }
+            eas_cfg_tuner_t *t = eas_config_add(&cfg, r->devid, r->ip, r->tuner);
+            if (t) { snprintf(t->chan, sizeof(t->chan), "%s", spec); changed = true; }
+            snprintf(msg, sizeof(msg), "%s-%d will record %s (%s).", r->devid, r->tuner, spec, eas_chan_type(spec));
+            break;
+        }
+        case 'x': case KEY_DC: {
+            if (!r) break;
+            eas_cfg_tuner_t *t = eas_config_find(&cfg, r->devid, r->ip, r->tuner);
+            if (t) { t->chan[0] = '\0'; changed = true; }
+            break;
+        }
+        case 'R':
+            nrows = eas_build_rows(rows, 64, tuners, total, &cfg);
+            if (sel >= nrows) sel = nrows ? nrows - 1 : 0;
+            snprintf(msg, sizeof(msg), "Refreshed tuner status.");
+            break;
+        case 's': case 'e': {
+            char *field = ch == 's' ? cfg.start : cfg.stop;
+            if (!eas_prompt(w, ch == 's' ? "Start (YYYY-MM-DD HH:MM, local time)" : "Stop (YYYY-MM-DD HH:MM, local time)",
+                            field, buf, 32)) break;
+            time_t tt;
+            if (eas_parse_when(buf, &tt)) { snprintf(msg, sizeof(msg), "'%s' isn't a time like 2026-11-17 12:10", buf); break; }
+            struct tm tmv;
+            localtime_r(&tt, &tmv);
+            strftime(field, 32, "%Y-%m-%d %H:%M", &tmv);
+            changed = true;
+            break;
+        }
+        case 'g':
+            if (!eas_prompt(w, "Segment length in seconds (10 or more)", "", buf, 8)) break;
+            if (atoi(buf) < 10) { snprintf(msg, sizeof(msg), "Segments must be at least 10 s."); break; }
+            cfg.seg = atoi(buf); changed = true;
+            break;
+        case 'f':
+            cfg.fmt3 = cfg.fmt3 == EAS_FMT_DBG ? EAS_FMT_PCAP : EAS_FMT_DBG; changed = true;
+            if (cfg.fmt3 == EAS_FMT_DBG) snprintf(msg, sizeof(msg), "Debug format: alert times are estimates. ALP-PCAP is better if your model supports it.");
+            break;
+        case 'o':
+            if (!eas_prompt(w, "Output folder (~ = your home)", cfg.outdir, buf, 500)) break;
+            snprintf(cfg.outdir, sizeof(cfg.outdir), "%s", buf); changed = true;
+            break;
+        case 'p':
+            if (!g_pause_services) { snprintf(msg, sizeof(msg), "Pausing services is off. Start the TUI with --pause-services to use it."); break; }
+            if (!eas_prompt(w, "Services to pause, space separated (- = none)", cfg.pause_units, buf, 500)) break;
+            if (!strcmp(buf, "-")) cfg.pause_units[0] = '\0';
+            else snprintf(cfg.pause_units, sizeof(cfg.pause_units), "%s", buf);
+            changed = true;
+            break;
+        case 'd': {
+            if (!g_pause_services) { snprintf(msg, sizeof(msg), "Pausing services is off. Start the TUI with --pause-services to use it."); break; }
+            char found[512];
+            int n = eas_detect_units(found, sizeof(found));
+            if (n <= 0) { snprintf(msg, sizeof(msg), "No running services that use an HDHomeRun were found."); break; }
+            snprintf(msg, sizeof(msg), "Found: %s", found);
+            wattron(w, A_REVERSE); mvwprintw(w, H - 2, 2, "%.*s", W - 4, msg); wattroff(w, A_REVERSE);
+            if (eas_confirm(w, "Use these as the services to pause?")) {
+                snprintf(cfg.pause_units, sizeof(cfg.pause_units), "%s", found);
+                changed = true;
+                snprintf(msg, sizeof(msg), "Pause list set.");
+            } else msg[0] = '\0';
+            break;
+        }
+        case 'h':
+            if (!g_pause_services) { snprintf(msg, sizeof(msg), "Pausing services is off. Start the TUI with --pause-services to use it."); break; }
+            if (!eas_prompt(w, "Pause services on which machine? user@host for another box over ssh, - = this machine",
+                            cfg.pause_ssh, buf, 120)) break;
+            if (!strcmp(buf, "-")) cfg.pause_ssh[0] = '\0';
+            else snprintf(cfg.pause_ssh, sizeof(cfg.pause_ssh), "%s", buf);
+            changed = true;
+            break;
+        case 'b':
+            if (!g_pause_services) { snprintf(msg, sizeof(msg), "Pausing services is off. Start the TUI with --pause-services to use it."); break; }
+            if (!eas_prompt(w, "Pause how many seconds before the start", "", buf, 8)) break;
+            cfg.pause_lead = atoi(buf) < 0 ? 0 : atoi(buf); changed = true;
+            break;
+        case 'r':
+            cfg.auto_render = !cfg.auto_render; changed = true;
+            break;
+        case 'l':
+            if (eas_prompt(w, "Test run length in minutes", "", buf, 8) && atoi(buf) > 0) { cfg.test_minutes = atoi(buf); changed = true; }
+            if (eas_prompt(w, "Test run segment seconds (10 or more)", "", buf, 8) && atoi(buf) >= 10) { cfg.test_seg = atoi(buf); changed = true; }
+            break;
+        case 'm':
+            eas_monitor_screen(w);
+            break;
+        case 'w': case 'W':
+            if (eas_web_status(NULL, NULL, 0) > 0) { eas_web_stop(); snprintf(msg, sizeof(msg), "Web server stopped."); }
+            else {
+                char url[600], err[200];
+                if (eas_web_serve(cfg.outdir, "", url, sizeof(url), err, sizeof(err)) == 0)
+                    snprintf(msg, sizeof(msg), "Results folder on the web: %s", url);
+                else snprintf(msg, sizeof(msg), "%s", err);
+            }
+            break;
+        case 'T': case 't': {
+            if (st.alive) { snprintf(msg, sizeof(msg), "A %s run is already active - cancel it from the monitor (m) first.", !strcmp(st.mode, "test") ? "test" : "scheduled"); break; }
+            char err[300];
+            if (eas_config_validate(&cfg, true, err, sizeof(err)) < 0) { snprintf(msg, sizeof(msg), "%s", err); break; }
+            char q[200];
+            snprintf(q, sizeof(q), "Start a %d-minute test now on %d tuner(s)%s?", cfg.test_minutes,
+                     eas_config_active_count(&cfg),
+                     (g_pause_services && cfg.pause_units[0]) ? ", pausing services" : " (tuners freed by you)");
+            if (!eas_confirm(w, q)) break;
+            eas_config_save(&cfg);
+            if (eas_launch_background("test", g_pause_services, err, sizeof(err)) < 0) { snprintf(msg, sizeof(msg), "%s", err); break; }
+            eas_monitor_screen(w);
+            nrows = eas_build_rows(rows, 64, tuners, total, &cfg);
+            break;
+        }
+        case 'A': case 'a': {
+            if (st.alive) { snprintf(msg, sizeof(msg), "A %s run is already active - cancel it from the monitor (m) first.", !strcmp(st.mode, "test") ? "test" : "scheduled"); break; }
+            char err[300];
+            if (eas_config_validate(&cfg, false, err, sizeof(err)) < 0) { snprintf(msg, sizeof(msg), "%s", err); break; }
+            eas_config_save(&cfg);
+            if (!eas_arm_review(w, &cfg)) break;
+            if (eas_launch_background("armed", g_pause_services, err, sizeof(err)) < 0) { snprintf(msg, sizeof(msg), "%s", err); break; }
+            eas_monitor_screen(w);
+            break;
+        }
+        default: break;
+        }
+        if (changed) {
+            if (eas_config_save(&cfg) < 0) snprintf(msg, sizeof(msg), "Could not save settings to %s", eas_config_dir());
+        }
+    }
+}
diff -ruN '--exclude=*.o' a/hdhomerun_tui-0.9.0/hdhr_dev.c tui/hdhr_dev.c
--- a/hdhomerun_tui-0.9.0/hdhr_dev.c	1969-12-31 17:00:00.000000000 -0700
+++ b/hdhr_eas_test-0.5/src/tui/hdhr_dev.c	2026-11-07 07:25:50.789063320 -0700
@@ -0,0 +1,456 @@
+/*
+ * Copyright (C) 2026 Brian Scott - HDHR EAS Test.
+ * hdhr_dev.c - HDHomeRun device helpers shared by the GUI.
+ * Logic follows HDHomeRun TUI v0.9 by Mark J. Colombo (RabbitEars). GPLv3.
+ *
+ * Note: libhdhomerun returns pointers into a buffer it reuses, so every
+ * answer is copied before the next request.
+ */
+#include "hdhr_dev.h"
+#include "player.h"
+
+#include <ctype.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+
+#include "hdhomerun.h"
+#include "hdhomerun_device.h"
+
+/* ------------------------------------------------------------------ */
+long hdhr_status_value(const char *s, const char *key) {
+    const char *f = s ? strstr(s, key) : NULL;
+    return f ? strtol(f + strlen(key), NULL, 0) : -999;
+}
+
+long hdhr_db_value(const char *s, const char *key) {
+    const char *f = s ? strstr(s, key) : NULL;
+    if (!f) return -999;
+    const char *p = strchr(f, '(');
+    const char *sp = strchr(f, ' ');
+    if (!p || (sp && sp < p)) return -999;
+    return strtol(p + 1, NULL, 10);
+}
+
+static int cmp_u(const void *a, const void *b) {
+    unsigned x = *(const unsigned *)a, y = *(const unsigned *)b;
+    return x < y ? -1 : x > y;
+}
+
+/* ------------------------------------------------------------------ */
+int hdhr_discover(hdhr_tuner_t *out, int max) {
+    plat_init();
+    struct hdhomerun_discover_t *ds = hdhomerun_discover_create(NULL);
+    if (!ds) return 0;
+    uint32_t types[1] = { HDHOMERUN_DEVICE_TYPE_TUNER };
+    if (hdhomerun_discover2_find_devices_broadcast(ds, HDHOMERUN_DISCOVER_FLAGS_IPV4_GENERAL, types, 1) < 0) {
+        hdhomerun_discover_destroy(ds);
+        return 0;
+    }
+    int n = 0;
+    struct hdhomerun_discover2_device_t *dev = hdhomerun_discover2_iter_device_first(ds);
+    while (dev && n < max) {
+        uint32_t id = hdhomerun_discover2_device_get_device_id(dev);
+        int tc = hdhomerun_discover2_device_get_tuner_count(dev);
+        bool legacy = hdhomerun_discover2_device_is_legacy(dev);
+        struct hdhomerun_discover2_device_if_t *dif = hdhomerun_discover2_iter_device_if_first(dev);
+        struct sockaddr_storage addr;
+        hdhomerun_discover2_device_if_get_ip_addr(dif, &addr);
+        char ip[64];
+        hdhomerun_sock_sockaddr_to_ip_str(ip, (struct sockaddr *)&addr, true);
+        for (int i = 0; i < tc && n < max; i++) {
+            out[n].device_id = id;
+            snprintf(out[n].ip, sizeof(out[n].ip), "%s", ip);
+            out[n].tuner = i;
+            out[n].tuners_on_device = tc;
+            out[n].legacy = legacy;
+            n++;
+        }
+        dev = hdhomerun_discover2_iter_device_next(dev);
+    }
+    hdhomerun_discover_destroy(ds);
+    return n;
+}
+
+int hdhr_add_by_ip(const char *ip, hdhr_tuner_t *list, int *count, int max) {
+    plat_init();
+    struct hdhomerun_device_t *hd = hdhomerun_device_create_from_str(ip, NULL);
+    if (!hd) return 0;
+    char *v;
+    char model[64] = "";
+    if (hdhomerun_device_get_var(hd, "/sys/model", &v, NULL) <= 0) { hdhomerun_device_destroy(hd); return 0; }
+    snprintf(model, sizeof(model), "%s", v);
+    uint32_t id = hdhomerun_device_get_device_id(hd);
+    for (int i = 0; i < *count; i++) if (list[i].device_id == id) { hdhomerun_device_destroy(hd); return 0; }
+    bool legacy = strstr(model, "hdhomerun3") || strstr(model, "hdhomerun_");
+    int tc = 0;
+    for (int i = 0; i < 8; i++) {
+        if (hdhomerun_device_set_tuner(hd, i) < 0) break;
+        struct hdhomerun_tuner_status_t st;
+        char *raw;
+        if (hdhomerun_device_get_tuner_status(hd, &raw, &st) <= 0) break;
+        tc++;
+    }
+    hdhomerun_device_destroy(hd);
+    int added = 0;
+    for (int i = 0; i < tc && *count < max; i++) {
+        hdhr_tuner_t *t = &list[(*count)++];
+        t->device_id = id;
+        snprintf(t->ip, sizeof(t->ip), "%s", ip);
+        t->tuner = i;
+        t->tuners_on_device = tc;
+        t->legacy = legacy;
+        added++;
+    }
+    return added;
+}
+
+/* ------------------------------------------------------------------ */
+int hdhr_get_status(struct hdhomerun_device_t *hd, hdhr_status_t *st) {
+    memset(st, 0, sizeof(*st));
+    st->id = -1;
+    st->ss_db = st->snq_db = -999;
+    struct hdhomerun_tuner_status_t ts;
+    char *raw;
+    if (hdhomerun_device_get_tuner_status(hd, &raw, &ts) <= 0) return -1;
+    char rawc[512];
+    snprintf(rawc, sizeof(rawc), "%s", raw);
+    st->ok = true;
+    snprintf(st->channel, sizeof(st->channel), "%s", ts.channel);
+    snprintf(st->lock, sizeof(st->lock), "%s", ts.lock_str);
+    snprintf(st->channel_disp, sizeof(st->channel_disp), "%s", ts.channel);
+    snprintf(st->lock_disp, sizeof(st->lock_disp), "%s", ts.lock_str);
+    if (!strncmp(ts.channel, "atsc3:", 6)) {
+        const char *c1 = strchr(ts.channel, ':');
+        const char *c2 = c1 ? strchr(c1 + 1, ':') : NULL;
+        if (c2) {
+            snprintf(st->channel_disp, sizeof(st->channel_disp), "%.*s", (int)(c2 - ts.channel), ts.channel);
+            snprintf(st->lock_disp, sizeof(st->lock_disp), "atsc3:%s", c2 + 1);
+        }
+    }
+    st->atsc3 = strstr(ts.lock_str, "atsc3") != NULL;
+    st->locked = strcmp(ts.lock_str, "none") != 0 && ts.lock_str[0];
+    st->ss = (int)ts.signal_strength;
+    st->snq = (int)ts.signal_to_noise_quality;
+    st->seq = (int)ts.symbol_error_quality;
+    st->ss_db = hdhr_db_value(rawc, "ss=");
+    st->snq_db = hdhr_db_value(rawc, "snq=");
+    long bps = hdhr_status_value(rawc, "bps=");
+    long pps = hdhr_status_value(rawc, "pps=");
+    st->mbps = (pps > 0 && bps != -999) ? bps / 1000000.0 : 0.0;
+    snprintf(st->id_label, sizeof(st->id_label), "%s", st->atsc3 ? "BSID" : "TSID");
+
+    char *v;
+    char streaminfo[4096] = "";
+    if (hdhomerun_device_get_tuner_streaminfo(hd, &v) > 0) snprintf(streaminfo, sizeof(streaminfo), "%s", v);
+    long id = hdhr_status_value(streaminfo, "tsid=");
+    char plpinfo[4096] = "";
+    if (st->atsc3 && hdhomerun_device_get_tuner_plpinfo(hd, &v) > 0) {
+        snprintf(plpinfo, sizeof(plpinfo), "%s", v);
+        long b = hdhr_status_value(plpinfo, "bsid=");
+        if (b != -999) id = b;
+    }
+    st->id = id == -999 ? -1 : id;
+
+    if (hdhomerun_device_get_tuner_target(hd, &v) > 0) snprintf(st->target, sizeof(st->target), "%s", v);
+    struct hdhomerun_tuner_vstatus_t vs;
+    char *vraw;
+    if (hdhomerun_device_get_tuner_vstatus(hd, &vraw, &vs) > 0 && vs.vchannel[0]) {
+        snprintf(st->vchannel, sizeof(st->vchannel), "%s", vs.vchannel);
+        snprintf(st->vname, sizeof(st->vname), "%s", vs.name);
+    }
+
+    char tmp[4096];
+    snprintf(tmp, sizeof(tmp), "%s", streaminfo);
+    for (char *save = NULL, *ln = strtok_r(tmp, "\n", &save); ln && st->nprog < HDHR_MAX_PROGS; ln = strtok_r(NULL, "\n", &save))
+        if (strchr(ln, ':') || strstr(ln, "program="))
+            snprintf(st->progs[st->nprog++], sizeof(st->progs[0]), "%s", ln);
+
+    if (plpinfo[0]) {
+        snprintf(tmp, sizeof(tmp), "%s", plpinfo);
+        int ids[HDHR_MAX_PLPS];
+        for (char *save = NULL, *ln = strtok_r(tmp, "\n", &save); ln && st->nplp < HDHR_MAX_PLPS; ln = strtok_r(NULL, "\n", &save)) {
+            if (!strncmp(ln, "bsid=", 5)) continue;
+            int id2 = 0;
+            sscanf(ln, "%d:", &id2);
+            ids[st->nplp] = id2;
+            snprintf(st->plps[st->nplp++], sizeof(st->plps[0]), "%s", ln);
+        }
+        /* sort by PLP id */
+        for (int i = 1; i < st->nplp; i++)
+            for (int j = i; j > 0 && ids[j - 1] > ids[j]; j--) {
+                int t = ids[j]; ids[j] = ids[j - 1]; ids[j - 1] = t;
+                char b[220];
+                memcpy(b, st->plps[j], sizeof(b));
+                memcpy(st->plps[j], st->plps[j - 1], sizeof(b));
+                memcpy(st->plps[j - 1], b, sizeof(b));
+            }
+    }
+    return 0;
+}
+
+/* ------------------------------------------------------------------ */
+int hdhr_channel_list(struct hdhomerun_device_t *hd, unsigned *out, int max) {
+    char *v;
+    if (hdhomerun_device_get_tuner_channelmap(hd, &v) <= 0) return 0;
+    char full[2048];
+    snprintf(full, sizeof(full), "%s", v);
+    int n = 0;
+    /* Some firmware answers "map ch ch ch ..." - use that list like the TUI does */
+    char tmp[2048];
+    snprintf(tmp, sizeof(tmp), "%s", full);
+    char *save = NULL;
+    char *tok = strtok_r(tmp, " \r\n", &save);
+    char map[64];
+    snprintf(map, sizeof(map), "%s", tok ? tok : "");
+    for (tok = strtok_r(NULL, " \r\n", &save); tok && n < max; tok = strtok_r(NULL, " \r\n", &save))
+        if (isdigit((unsigned char)*tok)) out[n++] = (unsigned)strtoul(tok, NULL, 10);
+    /* Otherwise the channels of that map from libhdhomerun's tables */
+    struct hdhomerun_channel_list_t *cl = n ? NULL : hdhomerun_channel_list_create(map);
+    if (cl) {
+        struct hdhomerun_channel_entry_t *e = hdhomerun_channel_list_first(cl);
+        while (e && n < max) {
+            unsigned ch = (unsigned)hdhomerun_channel_entry_channel_number(e);
+            bool dup = false;
+            for (int i = 0; i < n; i++) if (out[i] == ch) dup = true;
+            if (!dup) out[n++] = ch;
+            e = hdhomerun_channel_list_next(cl, e);
+        }
+        hdhomerun_channel_list_destroy(cl);
+    }
+    if (n > 1) qsort(out, n, sizeof(unsigned), cmp_u);
+    return n;
+}
+
+unsigned hdhr_current_rf(struct hdhomerun_device_t *hd) {
+    struct hdhomerun_tuner_status_t st;
+    char *raw;
+    if (hdhomerun_device_get_tuner_status(hd, &raw, &st) <= 0) return 0;
+    const char *p = strchr(st.channel, ':');
+    p = p ? p + 1 : st.channel;
+    return isdigit((unsigned char)*p) ? (unsigned)strtoul(p, NULL, 10) : 0;
+}
+
+int hdhr_tune(struct hdhomerun_device_t *hd, const char *what) {
+    char s[100];
+    snprintf(s, sizeof(s), "auto:%s", what);
+    if (hdhomerun_device_set_tuner_channel(hd, s) <= 0) return -1;
+    struct hdhomerun_tuner_status_t st;
+    hdhomerun_device_wait_for_lock(hd, &st);
+    return 0;
+}
+
+int hdhr_step_channel(struct hdhomerun_device_t *hd, int dir) {
+    unsigned chans[HDHR_MAX_CHANS];
+    int n = hdhr_channel_list(hd, chans, HDHR_MAX_CHANS);
+    unsigned cur = hdhr_current_rf(hd), next = 0;
+    if (n > 0) {
+        int idx = -1;
+        for (int i = 0; i < n; i++) if (chans[i] == cur) idx = i;
+        if (idx < 0) idx = dir > 0 ? -1 : n;
+        idx = (idx + dir + n) % n;
+        next = chans[idx];
+    } else {
+        next = cur ? cur + dir : (dir > 0 ? 2 : 69);
+        if (next > 69) next = 2;
+        if (next < 2) next = 69;
+    }
+    char s[32];
+    snprintf(s, sizeof(s), "auto:%u", next);
+    return hdhomerun_device_set_tuner_channel(hd, s) > 0 ? (int)next : -1;
+}
+
+unsigned hdhr_seek(struct hdhomerun_device_t *hd, int dir,
+                   bool (*progress)(unsigned ch, double left, void *user), void *user) {
+    unsigned chans[HDHR_MAX_CHANS];
+    int n = hdhr_channel_list(hd, chans, HDHR_MAX_CHANS);
+    unsigned cur = hdhr_current_rf(hd);
+    int idx = -1;
+    for (int i = 0; i < n; i++) if (chans[i] == cur) idx = i;
+    if (idx < 0 && n > 0) idx = dir > 0 ? -1 : n;
+    const unsigned start = cur;
+    bool first = true;
+    for (;;) {
+        unsigned ch;
+        if (n > 0) { idx = (idx + dir + n) % n; ch = chans[idx]; }
+        else {
+            if (!cur) cur = dir > 0 ? 1 : 70;
+            cur += dir;
+            if (cur > 69) cur = 2;
+            if (cur < 2) cur = 69;
+            ch = cur;
+        }
+        if (!first && ch == start) return 0;
+        first = false;
+        char s[32];
+        snprintf(s, sizeof(s), "auto:%u", ch);
+        hdhomerun_device_set_tuner_channel(hd, s);
+        for (int i = 0; i < 25; i++) {
+            struct hdhomerun_tuner_status_t st;
+            char *raw;
+            if (hdhomerun_device_get_tuner_status(hd, &raw, &st) > 0 && st.signal_to_noise_quality > 0) return ch;
+            if (progress && !progress(ch, (25 - i) / 10.0, user)) return 0;
+            plat_sleep_ms(100);
+        }
+    }
+}
+
+int hdhr_channel_maps(struct hdhomerun_device_t *hd, char maps[][32], int max, char *current, size_t curlen) {
+    char *v;
+    if (current && curlen) current[0] = '\0';
+    if (hdhomerun_device_get_tuner_channelmap(hd, &v) > 0 && current) {
+        snprintf(current, curlen, "%s", v);
+        current[strcspn(current, " \r\n")] = '\0';
+    }
+    if (hdhomerun_device_get_var(hd, "/sys/features", &v, NULL) <= 0) return 0;
+    char feat[2048];
+    snprintf(feat, sizeof(feat), "%s", v);
+    char *line = strstr(feat, "channelmap:");
+    if (!line) return 0;
+    line[strcspn(line, "\n")] = '\0';
+    int n = 0;
+    for (char *save = NULL, *t = strtok_r(line, " ", &save); t && n < max; t = strtok_r(NULL, " ", &save))
+        if (strcmp(t, "channelmap:")) snprintf(maps[n++], 32, "%s", t);
+    return n;
+}
+
+int hdhr_set_channel_map(struct hdhomerun_device_t *hd, const char *map) {
+    return hdhomerun_device_set_tuner_channelmap(hd, map) > 0 ? 0 : -1;
+}
+
+int hdhr_set_plps(struct hdhomerun_device_t *hd, const char *list, char *err, size_t errlen) {
+    struct hdhomerun_tuner_status_t st;
+    char *raw;
+    if (hdhomerun_device_get_tuner_status(hd, &raw, &st) <= 0 || !strstr(st.lock_str, "atsc3")) {
+        snprintf(err, errlen, "The tuner isn't locked to an ATSC 3.0 channel.");
+        return -1;
+    }
+    char freq[24] = "";
+    const char *p = strchr(st.channel, ':');
+    if (p) {
+        p++;
+        int i = 0;
+        while (isdigit((unsigned char)*p) && i < (int)sizeof(freq) - 1) freq[i++] = *p++;
+        freq[i] = '\0';
+    }
+    if (!freq[0]) { snprintf(err, errlen, "Couldn't read the current channel."); return -1; }
+    char out[64] = "";
+    if (list && *list) {
+        int j = 0;
+        for (const char *c = list; *c && j < (int)sizeof(out) - 1; c++) {
+            if (*c == ',' || *c == '+' || *c == ' ') { if (j && out[j - 1] != '+') out[j++] = '+'; }
+            else if (isdigit((unsigned char)*c)) out[j++] = *c;
+        }
+        while (j && out[j - 1] == '+') j--;
+        out[j] = '\0';
+    } else {
+        char *v;
+        if (hdhomerun_device_get_tuner_plpinfo(hd, &v) > 0) {
+            char info[4096];
+            snprintf(info, sizeof(info), "%s", v);
+            for (char *save = NULL, *ln = strtok_r(info, "\n", &save); ln; ln = strtok_r(NULL, "\n", &save)) {
+                int id;
+                if (sscanf(ln, "%d:", &id) == 1) {
+                    size_t L = strlen(out);
+                    snprintf(out + L, sizeof(out) - L, "%s%d", L ? "+" : "", id);
+                }
+            }
+        }
+    }
+    if (!out[0]) { snprintf(err, errlen, "No PLPs given or found."); return -1; }
+    char tune[100];
+    snprintf(tune, sizeof(tune), "atsc3:%s:%s", freq, out);
+    if (hdhomerun_device_set_tuner_channel(hd, tune) <= 0) { snprintf(err, errlen, "The tuner refused %s.", tune); return -1; }
+    hdhomerun_device_wait_for_lock(hd, &st);
+    return 0;
+}
+
+int hdhr_programs(struct hdhomerun_device_t *hd, hdhr_program_t *out, int max) {
+    char *v;
+    if (hdhomerun_device_get_tuner_streaminfo(hd, &v) <= 0) return 0;
+    char info[4096];
+    snprintf(info, sizeof(info), "%s", v);
+    int n = 0;
+    for (char *save = NULL, *ln = strtok_r(info, "\n", &save); ln && n < max; ln = strtok_r(NULL, "\n", &save)) {
+        while (isspace((unsigned char)*ln)) ln++;
+        hdhr_program_t *p = &out[n];
+        memset(p, 0, sizeof(*p));
+        p->plp = -1;
+        if (!strncmp(ln, "program=", 8)) {
+            snprintf(p->display, sizeof(p->display), "%s", ln);
+            sscanf(ln, "program=%15s", p->program);
+            const char *pl = strstr(ln, "plp=");
+            if (pl) sscanf(pl, "plp=%d", &p->plp);
+            n++;
+        } else if (!strncmp(ln, "program ", 8) || (isdigit((unsigned char)*ln) && strchr(ln, ':'))) {
+            snprintf(p->display, sizeof(p->display), "%s", ln);
+            if (!strncmp(ln, "program ", 8)) sscanf(ln, "program %15s", p->program);
+            else sscanf(ln, "%15s", p->program);
+            char *c = strchr(p->program, ':');
+            if (c) *c = '\0';
+            n++;
+        }
+    }
+    return n;
+}
+
+/* ------------------------------------------------------------------ */
+static int free_udp_port(void) {
+    plat_sock_t s = socket(AF_INET, SOCK_DGRAM, 0);
+    if (s == PLAT_BAD_SOCK) return -1;
+    struct sockaddr_in a;
+    memset(&a, 0, sizeof(a));
+    a.sin_family = AF_INET;
+    a.sin_addr.s_addr = htonl(INADDR_ANY);
+    a.sin_port = 0;
+    if (bind(s, (struct sockaddr *)&a, sizeof(a)) < 0) { plat_sock_close(s); return -1; }
+    socklen_t L = sizeof(a);
+    getsockname(s, (struct sockaddr *)&a, &L);
+    plat_sock_close(s);
+    return ntohs(a.sin_port);
+}
+
+int hdhr_free_udp_port(void) { return free_udp_port(); }
+
+int hdhr_stream_to_me(struct hdhomerun_device_t *hd, const hdhr_tuner_t *t, const char *program, int port,
+                      char *msg, size_t msglen) {
+    char path[64];
+    snprintf(path, sizeof(path), "/tuner%d/program", t->tuner);
+    if (hdhomerun_device_set_var(hd, path, program, NULL, NULL) < 0) { snprintf(msg, msglen, "Failed to set program %s.", program); return -1; }
+    char local[64];
+    if (plat_local_ip_towards(t->ip, local, sizeof(local)) < 0) { snprintf(msg, msglen, "Couldn't find this computer's address towards %s.", t->ip); return -1; }
+    char target[128];
+    snprintf(target, sizeof(target), "udp://%s:%d", local, port);
+    snprintf(path, sizeof(path), "/tuner%d/target", t->tuner);
+    if (hdhomerun_device_set_var(hd, path, target, NULL, NULL) < 0) { snprintf(msg, msglen, "Failed to set the stream target."); return -1; }
+    return 0;
+}
+
+int hdhr_play_start(struct hdhomerun_device_t *hd, const hdhr_tuner_t *t, const char *program,
+                    plat_pid_t *pid, char *msg, size_t msglen) {
+    char ffplay[1024];
+    if (!player_find(ffplay, sizeof(ffplay))) {
+        snprintf(msg, msglen, "ffplay not found. %s", player_hint());
+        return -1;
+    }
+    int port = free_udp_port();
+    if (port < 0) { snprintf(msg, msglen, "Couldn't find a free UDP port."); return -1; }
+    if (hdhr_stream_to_me(hd, t, program, port, msg, msglen) < 0) return -1;
+    char title[160];
+    snprintf(title, sizeof(title), "HDHR EAS Test - %08X-%d program %s", (unsigned)t->device_id, t->tuner, program);
+    *pid = player_spawn(ffplay, port, title, true);
+    if (*pid <= 0) {
+        hdhomerun_device_set_tuner_target(hd, "none");
+        snprintf(msg, msglen, "Couldn't start ffplay (%s).", ffplay);
+        return -1;
+    }
+    snprintf(msg, msglen, "Playing program %s in ffplay (port %d). Close the ffplay window or press q in it to stop.",
+             program, port);
+    return 0;
+}
+
+void hdhr_play_stop(struct hdhomerun_device_t *hd, plat_pid_t *pid) {
+    if (*pid > 0 && plat_pid_alive(*pid)) plat_terminate(*pid);
+    *pid = 0;
+    if (hd) hdhomerun_device_set_tuner_target(hd, "none");
+}
diff -ruN '--exclude=*.o' a/hdhomerun_tui-0.9.0/hdhr_dev.h tui/hdhr_dev.h
--- a/hdhomerun_tui-0.9.0/hdhr_dev.h	1969-12-31 17:00:00.000000000 -0700
+++ b/hdhr_eas_test-0.5/src/tui/hdhr_dev.h	2026-11-07 07:25:50.789395721 -0700
@@ -0,0 +1,86 @@
+/*
+ * Copyright (C) 2026 Brian Scott - HDHR EAS Test.
+ * hdhr_dev.h - HDHomeRun device helpers shared by the GUI (no UI code here).
+ * Logic follows HDHomeRun TUI v0.9 by Mark J. Colombo (RabbitEars). GPLv3.
+ */
+#ifndef HDHR_DEV_H
+#define HDHR_DEV_H
+
+#include <stdbool.h>
+#include <stdint.h>
+#include "plat.h"
+
+struct hdhomerun_device_t;
+
+#define HDHR_MAX_TUNERS 32
+#define HDHR_MAX_PROGS  64
+#define HDHR_MAX_PLPS   64
+#define HDHR_MAX_CHANS  256
+#define HDHR_MAX_MAPS   20
+
+typedef struct {
+    uint32_t device_id;
+    char ip[64];
+    int tuner;
+    int tuners_on_device;
+    bool legacy;
+} hdhr_tuner_t;
+
+typedef struct {
+    bool ok;
+    char channel[64];        /* raw, e.g. "atsc3:31:0+1" or "8vsb:27"      */
+    char channel_disp[64];   /* "atsc3:31"                                   */
+    char lock[32];           /* raw lock string                              */
+    char lock_disp[64];      /* "atsc3:0+1" or "8vsb"                         */
+    bool atsc3;
+    bool locked;
+    char id_label[8];        /* BSID / TSID                                   */
+    long id;                 /* -1 unknown                                    */
+    int ss, snq, seq;        /* percentages                                   */
+    long ss_db, snq_db;      /* -999 unknown                                  */
+    double mbps;
+    char target[160];
+    char vchannel[32], vname[64];
+    int nprog;
+    char progs[HDHR_MAX_PROGS][200];
+    int nplp;
+    char plps[HDHR_MAX_PLPS][220];
+} hdhr_status_t;
+
+typedef struct {
+    char display[256];
+    char program[16];
+    int plp;
+} hdhr_program_t;
+
+int  hdhr_discover(hdhr_tuner_t *out, int max);
+int  hdhr_add_by_ip(const char *ip, hdhr_tuner_t *list, int *count, int max);   /* tuners added */
+
+int  hdhr_get_status(struct hdhomerun_device_t *hd, hdhr_status_t *st);
+long hdhr_status_value(const char *s, const char *key);   /* -999 if missing */
+long hdhr_db_value(const char *s, const char *key);
+
+int  hdhr_channel_list(struct hdhomerun_device_t *hd, unsigned *out, int max);
+unsigned hdhr_current_rf(struct hdhomerun_device_t *hd);
+int  hdhr_tune(struct hdhomerun_device_t *hd, const char *what);              /* "auto:<what>" + wait for lock */
+int  hdhr_step_channel(struct hdhomerun_device_t *hd, int dir);              /* left/right */
+/* Seek to the next channel with signal; progress(ch, secs_left, user) may return false to stop. */
+unsigned hdhr_seek(struct hdhomerun_device_t *hd, int dir,
+                   bool (*progress)(unsigned ch, double left, void *user), void *user);
+int  hdhr_channel_maps(struct hdhomerun_device_t *hd, char maps[][32], int max, char *current, size_t curlen);
+int  hdhr_set_channel_map(struct hdhomerun_device_t *hd, const char *map);
+/* "0,1" or "" (= all PLPs on the current ATSC 3.0 channel). */
+int  hdhr_set_plps(struct hdhomerun_device_t *hd, const char *list, char *err, size_t errlen);
+int  hdhr_programs(struct hdhomerun_device_t *hd, hdhr_program_t *out, int max);
+
+/* ffplay: point the tuner's stream (MPEG-TS over UDP) at this computer and open
+ * ffplay on it. ATSC 3.0 audio (AC-4) needs the AC-4 ffplay build. */
+int  hdhr_free_udp_port(void);
+/* set the program filter and send the stream to this computer, UDP <port> */
+int  hdhr_stream_to_me(struct hdhomerun_device_t *hd, const hdhr_tuner_t *t, const char *program, int port,
+                       char *msg, size_t msglen);
+int  hdhr_play_start(struct hdhomerun_device_t *hd, const hdhr_tuner_t *t, const char *program,
+                     plat_pid_t *pid, char *msg, size_t msglen);
+void hdhr_play_stop(struct hdhomerun_device_t *hd, plat_pid_t *pid);
+
+#endif
diff -ruN '--exclude=*.o' a/hdhomerun_tui-0.9.0/plat.c tui/plat.c
--- a/hdhomerun_tui-0.9.0/plat.c	1969-12-31 17:00:00.000000000 -0700
+++ b/hdhr_eas_test-0.5/src/tui/plat.c	2026-11-07 07:39:07.883483503 -0700
@@ -0,0 +1,712 @@
+/*
+ * Copyright (C) 2026 Brian Scott - HDHR EAS Test.
+ * plat.c - portability layer for HDHR EAS Test (Linux/Unix and Windows). GPLv3.
+ */
+#include "plat.h"
+
+#include <ctype.h>
+#include <errno.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+
+#ifdef _WIN32
+#  include <direct.h>
+#  include <io.h>
+#  include <process.h>
+#  include <shellapi.h>
+#else
+#  include <fcntl.h>
+#  include <limits.h>
+#  include <pwd.h>
+#  include <signal.h>
+#  include <sys/select.h>
+#  include <sys/statvfs.h>
+#  include <sys/time.h>
+#  include <sys/wait.h>
+#endif
+
+/* ------------------------------------------------------------------ */
+void plat_init(void) {
+#ifdef _WIN32
+    static bool done = false;
+    if (!done) {
+        WSADATA w;
+        WSAStartup(MAKEWORD(2, 2), &w);
+        done = true;
+    }
+#else
+    signal(SIGPIPE, SIG_IGN);
+#endif
+}
+
+/* ------------------------------------------------------------------ */
+/* Paths                                                               */
+/* ------------------------------------------------------------------ */
+static void slashes(char *s) {
+#ifdef _WIN32
+    for (; *s; s++) if (*s == '\\') *s = '/';
+#else
+    (void)s;
+#endif
+}
+
+const char *plat_home(void) {
+    static char home[1024];
+    if (home[0]) return home;
+#ifdef _WIN32
+    const char *h = getenv("USERPROFILE");
+    if (!h || !*h) h = getenv("HOMEPATH");
+    snprintf(home, sizeof(home), "%s", h && *h ? h : "C:/");
+#else
+    const char *h = getenv("HOME");
+    if (!h || !*h) {
+        struct passwd *pw = getpwuid(getuid());
+        h = pw ? pw->pw_dir : "/tmp";
+    }
+    snprintf(home, sizeof(home), "%s", h);
+#endif
+    slashes(home);
+    return home;
+}
+
+const char *plat_config_base(void) {
+    static char base[1024];
+    if (base[0]) return base;
+#ifdef _WIN32
+    const char *a = getenv("APPDATA");
+    if (a && *a) snprintf(base, sizeof(base), "%s", a);
+    else snprintf(base, sizeof(base), "%s/AppData/Roaming", plat_home());
+#else
+    const char *x = getenv("XDG_CONFIG_HOME");
+    if (x && *x) snprintf(base, sizeof(base), "%s", x);
+    else snprintf(base, sizeof(base), "%s/.config", plat_home());
+#endif
+    slashes(base);
+    return base;
+}
+
+static bool is_absolute(const char *p) {
+    if (p[0] == '/' || p[0] == '\\') return true;
+#ifdef _WIN32
+    if (isalpha((unsigned char)p[0]) && p[1] == ':') return true;
+#endif
+    return false;
+}
+
+/* "~/x" -> home/x. A relative path ("eas2026") is also taken as relative to
+ * home, not to whatever folder the program happened to start in: background
+ * processes run from the home folder (see plat_spawn), so this keeps every
+ * process agreeing on where the files are. */
+void plat_expand_home(const char *in, char *out, size_t n) {
+    if (in[0] == '~' && (in[1] == '/' || in[1] == '\\' || in[1] == '\0'))
+        snprintf(out, n, "%s%s", plat_home(), in + 1);
+    else if (in[0] && !is_absolute(in))
+        snprintf(out, n, "%s/%s", plat_home(), in);
+    else
+        snprintf(out, n, "%s", in);
+    slashes(out);
+}
+
+static int mkdir1(const char *p) {
+#ifdef _WIN32
+    return _mkdir(p);
+#else
+    return mkdir(p, 0755);
+#endif
+}
+
+int plat_mkdir_p(const char *path) {
+    char tmp[1024];
+    snprintf(tmp, sizeof(tmp), "%s", path);
+    slashes(tmp);
+    size_t L = strlen(tmp);
+    while (L > 1 && tmp[L - 1] == '/') tmp[--L] = '\0';
+    char *start = tmp + 1;
+#ifdef _WIN32
+    if (isalpha((unsigned char)tmp[0]) && tmp[1] == ':') start = tmp + 3;   /* C:/ */
+    else if (tmp[0] == '/' && tmp[1] == '/') {                              /* //server/share/ */
+        char *p = strchr(tmp + 2, '/');
+        p = p ? strchr(p + 1, '/') : NULL;
+        start = p ? p + 1 : tmp + L;
+    }
+#endif
+    for (char *p = start; *p; p++) {
+        if (*p == '/') {
+            *p = '\0';
+            if (mkdir1(tmp) < 0 && errno != EEXIST && !plat_is_dir(tmp)) return -1;
+            *p = '/';
+        }
+    }
+    if (mkdir1(tmp) < 0 && errno != EEXIST && !plat_is_dir(tmp)) return -1;
+    return 0;
+}
+
+int plat_exe_path(char *out, size_t n) {
+#ifdef _WIN32
+    char buf[MAX_PATH * 2];
+    DWORD L = GetModuleFileNameA(NULL, buf, sizeof(buf));
+    if (L == 0 || L >= sizeof(buf)) return -1;
+    snprintf(out, n, "%s", buf);
+    slashes(out);
+    return 0;
+#else
+    char buf[PATH_MAX];
+    ssize_t L = readlink("/proc/self/exe", buf, sizeof(buf) - 1);
+    if (L <= 0) return -1;
+    buf[L] = '\0';
+    snprintf(out, n, "%s", buf);
+    return 0;
+#endif
+}
+
+int plat_exe_dir(char *out, size_t n) {
+    if (plat_exe_path(out, n) < 0) return -1;
+    char *s = strrchr(out, '/');
+    if (s) *s = '\0';
+    return 0;
+}
+
+bool plat_is_file(const char *path) {
+    struct stat st;
+    return stat(path, &st) == 0 && (st.st_mode & S_IFMT) == S_IFREG;
+}
+
+bool plat_is_dir(const char *path) {
+    struct stat st;
+    return stat(path, &st) == 0 && (st.st_mode & S_IFMT) == S_IFDIR;
+}
+
+bool plat_exists(const char *path) {
+    struct stat st;
+    return stat(path, &st) == 0;
+}
+
+long long plat_file_size(const char *path) {
+#ifdef _WIN32
+    struct __stat64 st;
+    if (_stat64(path, &st) != 0) return -1;
+    return (long long)st.st_size;
+#else
+    struct stat st;
+    if (stat(path, &st) != 0) return -1;
+    return (long long)st.st_size;
+#endif
+}
+
+int plat_rename_replace(const char *from, const char *to) {
+#ifdef _WIN32
+    return MoveFileExA(from, to, MOVEFILE_REPLACE_EXISTING | MOVEFILE_COPY_ALLOWED) ? 0 : -1;
+#else
+    return rename(from, to);
+#endif
+}
+
+double plat_free_bytes(const char *path) {
+    char dir[1024];
+    plat_expand_home(path, dir, sizeof(dir));
+    for (;;) {
+        if (plat_is_dir(dir)) {
+#ifdef _WIN32
+            ULARGE_INTEGER avail;
+            if (GetDiskFreeSpaceExA(dir, &avail, NULL, NULL)) return (double)avail.QuadPart;
+            return -1;
+#else
+            struct statvfs v;
+            if (statvfs(dir, &v) == 0) return (double)v.f_bavail * (double)v.f_frsize;
+            return -1;
+#endif
+        }
+        char *s = strrchr(dir, '/');
+        if (!s) return -1;
+        if (s == dir) { dir[1] = '\0'; continue; }
+#ifdef _WIN32
+        if (s == dir + 2 && dir[1] == ':') { dir[3] = '\0'; if (!plat_is_dir(dir)) return -1; continue; }
+#endif
+        *s = '\0';
+    }
+}
+
+/* ------------------------------------------------------------------ */
+/* Time                                                                */
+/* ------------------------------------------------------------------ */
+void plat_sleep_ms(int ms) {
+#ifdef _WIN32
+    Sleep((DWORD)ms);
+#else
+    struct timespec ts = { ms / 1000, (long)(ms % 1000) * 1000000L };
+    while (nanosleep(&ts, &ts) < 0 && errno == EINTR) { /* keep sleeping unless asked to stop */ break; }
+#endif
+}
+
+void plat_localtime(time_t t, struct tm *out) {
+#ifdef _WIN32
+    localtime_s(out, &t);
+#else
+    localtime_r(&t, out);
+#endif
+}
+
+/* ------------------------------------------------------------------ */
+/* Network                                                             */
+/* ------------------------------------------------------------------ */
+void plat_sock_close(plat_sock_t s) {
+#ifdef _WIN32
+    closesocket(s);
+#else
+    close(s);
+#endif
+}
+
+int plat_sock_set_nonblock(plat_sock_t s) {
+#ifdef _WIN32
+    u_long one = 1;
+    return ioctlsocket(s, FIONBIO, &one) == 0 ? 0 : -1;
+#else
+    int fl = fcntl(s, F_GETFL, 0);
+    return fcntl(s, F_SETFL, fl | O_NONBLOCK);
+#endif
+}
+
+static int wait_sock(plat_sock_t s, int timeout_ms, bool write) {
+    fd_set fs, es;
+    FD_ZERO(&fs);
+    FD_ZERO(&es);
+    FD_SET(s, &fs);
+    FD_SET(s, &es);
+    struct timeval tv = { timeout_ms / 1000, (timeout_ms % 1000) * 1000 };
+    int r = select((int)s + 1, write ? NULL : &fs, write ? &fs : NULL, &es, timeout_ms < 0 ? NULL : &tv);
+    if (r > 0 && FD_ISSET(s, &es) && !FD_ISSET(s, &fs)) return -1;
+    return r;
+}
+
+int plat_wait_readable(plat_sock_t s, int timeout_ms) { return wait_sock(s, timeout_ms, false); }
+
+bool plat_sock_would_block(void) {
+#ifdef _WIN32
+    int e = WSAGetLastError();
+    return e == WSAEWOULDBLOCK || e == WSAEINTR;
+#else
+    return errno == EAGAIN || errno == EWOULDBLOCK || errno == EINTR;
+#endif
+}
+
+const char *plat_sock_error(void) {
+#ifdef _WIN32
+    static char buf[64];
+    snprintf(buf, sizeof(buf), "socket error %d", WSAGetLastError());
+    return buf;
+#else
+    return strerror(errno);
+#endif
+}
+
+plat_sock_t plat_tcp_connect(const char *ip, int port, int timeout_ms, char *err, size_t errlen) {
+    plat_init();
+    plat_sock_t s = socket(AF_INET, SOCK_STREAM, 0);
+    if (s == PLAT_BAD_SOCK) { snprintf(err, errlen, "socket(): %s", plat_sock_error()); return PLAT_BAD_SOCK; }
+    int rcvbuf = 8 * 1024 * 1024;
+    setsockopt(s, SOL_SOCKET, SO_RCVBUF, (const char *)&rcvbuf, sizeof(rcvbuf));
+    struct sockaddr_in sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons((unsigned short)port);
+    if (inet_pton(AF_INET, ip, &sa.sin_addr) != 1) {
+        snprintf(err, errlen, "bad IP address '%s'", ip);
+        plat_sock_close(s);
+        return PLAT_BAD_SOCK;
+    }
+    plat_sock_set_nonblock(s);
+    int rc = connect(s, (struct sockaddr *)&sa, sizeof(sa));
+    if (rc < 0) {
+#ifdef _WIN32
+        bool pending = WSAGetLastError() == WSAEWOULDBLOCK;
+#else
+        bool pending = errno == EINPROGRESS;
+#endif
+        if (!pending) { snprintf(err, errlen, "connect: %s", plat_sock_error()); plat_sock_close(s); return PLAT_BAD_SOCK; }
+        if (wait_sock(s, timeout_ms, true) <= 0) {
+            snprintf(err, errlen, "connect: no answer from %s:%d", ip, port);
+            plat_sock_close(s);
+            return PLAT_BAD_SOCK;
+        }
+        int soerr = 0;
+        socklen_t sl = sizeof(soerr);
+        getsockopt(s, SOL_SOCKET, SO_ERROR, (char *)&soerr, &sl);
+        if (soerr) {
+            snprintf(err, errlen, "connect: %s refused (%d)", ip, soerr);
+            plat_sock_close(s);
+            return PLAT_BAD_SOCK;
+        }
+    }
+    return s;
+}
+
+int plat_local_ip_towards(const char *ip, char *out, size_t n) {
+    plat_init();
+    plat_sock_t s = socket(AF_INET, SOCK_DGRAM, 0);
+    if (s == PLAT_BAD_SOCK) return -1;
+    struct sockaddr_in sa;
+    memset(&sa, 0, sizeof(sa));
+    sa.sin_family = AF_INET;
+    sa.sin_port = htons(65001);
+    if (inet_pton(AF_INET, ip, &sa.sin_addr) != 1 || connect(s, (struct sockaddr *)&sa, sizeof(sa)) < 0) {
+        plat_sock_close(s);
+        return -1;
+    }
+    struct sockaddr_in me;
+    socklen_t ml = sizeof(me);
+    int r = getsockname(s, (struct sockaddr *)&me, &ml);
+    plat_sock_close(s);
+    if (r < 0) return -1;
+    if (!inet_ntop(AF_INET, &me.sin_addr, out, (socklen_t)n)) return -1;
+    return strcmp(out, "0.0.0.0") ? 0 : -1;
+}
+
+int plat_lan_ip(char *out, size_t n) {
+    /* A UDP "connect" sends nothing; it just picks the interface the OS would use. */
+    if (plat_local_ip_towards("192.168.1.1", out, n) == 0) return 0;
+    if (plat_local_ip_towards("10.0.0.1", out, n) == 0) return 0;
+    if (plat_local_ip_towards("8.8.8.8", out, n) == 0) return 0;
+    snprintf(out, n, "localhost");
+    return -1;
+}
+
+/* ------------------------------------------------------------------ */
+/* Processes                                                           */
+/* ------------------------------------------------------------------ */
+plat_pid_t plat_getpid(void) {
+#ifdef _WIN32
+    return (plat_pid_t)GetCurrentProcessId();
+#else
+    return (plat_pid_t)getpid();
+#endif
+}
+
+bool plat_pid_alive(plat_pid_t pid) {
+    if (pid <= 0) return false;
+#ifdef _WIN32
+    HANDLE h = OpenProcess(PROCESS_QUERY_LIMITED_INFORMATION, FALSE, (DWORD)pid);
+    if (!h) return false;
+    DWORD code = 0;
+    BOOL ok = GetExitCodeProcess(h, &code);
+    CloseHandle(h);
+    return ok && code == STILL_ACTIVE;
+#else
+    if (kill((pid_t)pid, 0) == 0) {
+        /* a zombie child of ours still "exists" - reap and report dead */
+        int st;
+        if (waitpid((pid_t)pid, &st, WNOHANG) == (pid_t)pid) return false;
+        return true;
+    }
+    return errno == EPERM;
+#endif
+}
+
+#ifdef _WIN32
+/* Quote one argument for CreateProcess' command line. */
+static void append_arg(char *cmd, size_t n, const char *a) {
+    size_t L = strlen(cmd);
+    if (L) { if (L + 1 < n) { cmd[L++] = ' '; cmd[L] = '\0'; } }
+    bool quote = !*a || strpbrk(a, " \t\"") != NULL;
+    if (!quote) { snprintf(cmd + L, n - L, "%s", a); return; }
+    if (L + 1 < n) { cmd[L++] = '"'; }
+    int bs = 0;
+    for (const char *p = a; *p && L + 4 < n; p++) {
+        if (*p == '\\') { bs++; cmd[L++] = '\\'; continue; }
+        if (*p == '"') { for (int i = 0; i < bs + 1 && L + 2 < n; i++) cmd[L++] = '\\'; }
+        bs = 0;
+        cmd[L++] = *p;
+    }
+    for (int i = 0; i < bs && L + 2 < n; i++) cmd[L++] = '\\';
+    if (L + 1 < n) cmd[L++] = '"';
+    cmd[L] = '\0';
+}
+#endif
+
+bool plat_find_program(const char *name, char *out, size_t n) {
+    if (strchr(name, '/')
+#ifdef _WIN32
+        || strchr(name, '\\')
+#endif
+       ) {
+        if (plat_is_file(name)) { snprintf(out, n, "%s", name); return true; }
+        return false;
+    }
+    const char *path = getenv("PATH");
+    if (!path) return false;
+    char buf[8192];
+    snprintf(buf, sizeof(buf), "%s", path);
+#ifdef _WIN32
+    const char *sep = ";";
+    const char *exts[] = { "", ".exe", ".bat", ".cmd", NULL };
+#else
+    const char *sep = ":";
+    const char *exts[] = { "", NULL };
+#endif
+    char *save = NULL;
+    for (char *d = strtok_r(buf, sep, &save); d; d = strtok_r(NULL, sep, &save)) {
+        for (int i = 0; exts[i]; i++) {
+            char p[2048];
+            snprintf(p, sizeof(p), "%s/%s%s", d, name, exts[i]);
+#ifdef _WIN32
+            if (plat_is_file(p)) { snprintf(out, n, "%s", p); return true; }
+#else
+            if (plat_is_file(p) && access(p, X_OK) == 0) { snprintf(out, n, "%s", p); return true; }
+#endif
+        }
+    }
+    return false;
+}
+
+plat_pid_t plat_spawn(const char *const argv[], const char *logfile, bool append, bool detached) {
+    return plat_spawn_ex(argv, logfile, append, detached, false);
+}
+
+/* show = the program has its own window (ffplay); otherwise it runs hidden */
+plat_pid_t plat_spawn_ex(const char *const argv[], const char *logfile, bool append, bool detached, bool show) {
+#ifdef _WIN32
+    char cmd[8192] = "";
+    for (int i = 0; argv[i]; i++) append_arg(cmd, sizeof(cmd), argv[i]);
+    char prog[2048];
+    const char *app = NULL;
+    if (plat_find_program(argv[0], prog, sizeof(prog))) app = prog;
+
+    SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
+    HANDLE hout = INVALID_HANDLE_VALUE;
+    if (logfile) {
+        hout = CreateFileA(logfile, append ? FILE_APPEND_DATA : GENERIC_WRITE,
+                           FILE_SHARE_READ | FILE_SHARE_WRITE, &sa,
+                           append ? OPEN_ALWAYS : CREATE_ALWAYS, FILE_ATTRIBUTE_NORMAL, NULL);
+    } else {
+        hout = CreateFileA("NUL", GENERIC_WRITE, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, 0, NULL);
+    }
+    HANDLE hin = CreateFileA("NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, 0, NULL);
+    STARTUPINFOA si;
+    memset(&si, 0, sizeof(si));
+    si.cb = sizeof(si);
+    si.dwFlags = STARTF_USESTDHANDLES | (show ? 0 : STARTF_USESHOWWINDOW);
+    si.wShowWindow = SW_HIDE;
+    si.hStdInput = hin;
+    si.hStdOutput = hout;
+    si.hStdError = hout;
+    PROCESS_INFORMATION pi;
+    DWORD flags = CREATE_NO_WINDOW | EXTENDED_STARTUPINFO_PRESENT;
+    if (detached) flags |= CREATE_NEW_PROCESS_GROUP | CREATE_BREAKAWAY_FROM_JOB;
+
+    /* Hand the child ONLY its stdin/stdout handles. Without this list Windows
+     * passes every inheritable handle the GUI has open, and a long-lived child
+     * (the web server) would keep those files - and folders - locked. */
+    STARTUPINFOEXA six;
+    memset(&six, 0, sizeof(six));
+    six.StartupInfo = si;
+    six.StartupInfo.cb = sizeof(six);
+    HANDLE inherit[2];
+    int ninh = 0;
+    if (hin != INVALID_HANDLE_VALUE) inherit[ninh++] = hin;
+    if (hout != INVALID_HANDLE_VALUE) inherit[ninh++] = hout;
+    SIZE_T asz = 0;
+    InitializeProcThreadAttributeList(NULL, 1, 0, &asz);
+    LPPROC_THREAD_ATTRIBUTE_LIST al = (LPPROC_THREAD_ATTRIBUTE_LIST)HeapAlloc(GetProcessHeap(), 0, asz);
+    bool have_list = al && InitializeProcThreadAttributeList(al, 1, 0, &asz) &&
+                     (ninh == 0 || UpdateProcThreadAttribute(al, 0, PROC_THREAD_ATTRIBUTE_HANDLE_LIST,
+                                                             inherit, ninh * sizeof(HANDLE), NULL, NULL));
+    if (have_list) six.lpAttributeList = al;
+    else flags &= ~EXTENDED_STARTUPINFO_PRESENT;
+    BOOL inh = ninh > 0;
+
+    /* Start in the home folder, never in the program's folder: a child's
+     * current directory locks that folder against deletion while it runs. */
+    const char *cwd = plat_home();
+    LPSTARTUPINFOA psi = have_list ? &six.StartupInfo : &si;
+    BOOL ok = CreateProcessA(app, cmd, NULL, NULL, inh, flags, NULL, cwd, psi, &pi);
+    if (!ok && detached) {   /* breakaway not allowed in some job objects */
+        flags &= ~CREATE_BREAKAWAY_FROM_JOB;
+        ok = CreateProcessA(app, cmd, NULL, NULL, inh, flags, NULL, cwd, psi, &pi);
+    }
+    if (have_list) DeleteProcThreadAttributeList(al);
+    if (al) HeapFree(GetProcessHeap(), 0, al);
+    if (hout != INVALID_HANDLE_VALUE) CloseHandle(hout);
+    if (hin != INVALID_HANDLE_VALUE) CloseHandle(hin);
+    if (!ok) return -1;
+    CloseHandle(pi.hThread);
+    CloseHandle(pi.hProcess);
+    return (plat_pid_t)pi.dwProcessId;
+#else
+    (void)show;
+    int pfd[2] = { -1, -1 };
+    if (detached && pipe(pfd) < 0) return -1;
+    pid_t a = fork();
+    if (a < 0) return -1;
+    if (a == 0) {
+        if (chdir(plat_home()) != 0) { int r = chdir("/"); (void)r; }   /* don't pin the program's folder */
+        if (detached) {
+            setsid();
+            pid_t b = fork();
+            if (b != 0) {
+                if (b > 0) { int pid = (int)b; ssize_t w = write(pfd[1], &pid, sizeof(pid)); (void)w; }
+                _exit(0);
+            }
+            close(pfd[0]);
+            close(pfd[1]);
+        }
+        int nul = open("/dev/null", O_RDONLY);
+        int fd = logfile ? open(logfile, O_WRONLY | O_CREAT | (append ? O_APPEND : O_TRUNC), 0644)
+                         : open("/dev/null", O_WRONLY);
+        if (nul >= 0) { dup2(nul, 0); close(nul); }
+        if (fd >= 0) { dup2(fd, 1); dup2(fd, 2); close(fd); }
+        for (int k = 3; k < 1024; k++) close(k);
+        signal(SIGHUP, SIG_IGN);
+        signal(SIGPIPE, SIG_DFL);
+        execvp(argv[0], (char *const *)argv);
+        _exit(127);
+    }
+    if (!detached) return (plat_pid_t)a;
+    close(pfd[1]);
+    int gpid = -1;
+    ssize_t r = read(pfd[0], &gpid, sizeof(gpid));
+    close(pfd[0]);
+    waitpid(a, NULL, 0);
+    return r == (ssize_t)sizeof(gpid) ? (plat_pid_t)gpid : -1;
+#endif
+}
+
+int plat_wait(plat_pid_t pid, int timeout_ms) {
+#ifdef _WIN32
+    HANDLE h = OpenProcess(SYNCHRONIZE | PROCESS_QUERY_LIMITED_INFORMATION, FALSE, (DWORD)pid);
+    if (!h) return -1;
+    DWORD w = WaitForSingleObject(h, timeout_ms < 0 ? INFINITE : (DWORD)timeout_ms);
+    if (w == WAIT_TIMEOUT) { CloseHandle(h); return -2; }
+    DWORD code = 0;
+    GetExitCodeProcess(h, &code);
+    CloseHandle(h);
+    return (int)code;
+#else
+    int st = 0;
+    if (timeout_ms < 0) {
+        while (waitpid((pid_t)pid, &st, 0) < 0) { if (errno != EINTR) return -1; }
+    } else {
+        int waited = 0;
+        for (;;) {
+            pid_t r = waitpid((pid_t)pid, &st, WNOHANG);
+            if (r == (pid_t)pid) break;
+            if (r < 0 && errno != EINTR) return -1;
+            if (waited >= timeout_ms) return -2;
+            plat_sleep_ms(20);
+            waited += 20;
+        }
+    }
+    return WIFEXITED(st) ? WEXITSTATUS(st) : 128;
+#endif
+}
+
+int plat_terminate(plat_pid_t pid) {
+#ifdef _WIN32
+    HANDLE h = OpenProcess(PROCESS_TERMINATE, FALSE, (DWORD)pid);
+    if (!h) return -1;
+    BOOL ok = TerminateProcess(h, 1);
+    CloseHandle(h);
+    return ok ? 0 : -1;
+#else
+    return kill((pid_t)pid, SIGTERM);
+#endif
+}
+
+int plat_run_capture(const char *cmd, char *out, size_t n) {
+    if (out && n) out[0] = '\0';
+#ifdef _WIN32
+    /* like _popen("cmd /c ..."), but with no console window flashing up */
+    SECURITY_ATTRIBUTES sa = { sizeof(sa), NULL, TRUE };
+    HANDLE rd = NULL, wr = NULL;
+    if (!CreatePipe(&rd, &wr, &sa, 0)) return -1;
+    SetHandleInformation(rd, HANDLE_FLAG_INHERIT, 0);
+    HANDLE nul = CreateFileA("NUL", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_WRITE, &sa, OPEN_EXISTING, 0, NULL);
+    STARTUPINFOA si;
+    memset(&si, 0, sizeof(si));
+    si.cb = sizeof(si);
+    si.dwFlags = STARTF_USESTDHANDLES | STARTF_USESHOWWINDOW;
+    si.wShowWindow = SW_HIDE;
+    si.hStdInput = nul;
+    si.hStdOutput = wr;
+    si.hStdError = wr;
+    size_t L = strlen(cmd) + 32;
+    char *line = malloc(L);
+    if (!line) { CloseHandle(rd); CloseHandle(wr); if (nul != INVALID_HANDLE_VALUE) CloseHandle(nul); return -1; }
+    snprintf(line, L, "cmd.exe /c %s", cmd);
+    PROCESS_INFORMATION pi;
+    BOOL ok = CreateProcessA(NULL, line, NULL, NULL, TRUE, CREATE_NO_WINDOW, NULL, plat_home(), &si, &pi);
+    free(line);
+    CloseHandle(wr);
+    if (nul != INVALID_HANDLE_VALUE) CloseHandle(nul);
+    if (!ok) { CloseHandle(rd); return -1; }
+    size_t used = 0;
+    char buf[512];
+    DWORD got;
+    while (ReadFile(rd, buf, sizeof(buf), &got, NULL) && got > 0) {
+        if (out && used + 1 < n) {
+            size_t c = got < n - 1 - used ? got : n - 1 - used;
+            memcpy(out + used, buf, c);
+            used += c;
+            out[used] = '\0';
+        }
+    }
+    CloseHandle(rd);
+    WaitForSingleObject(pi.hProcess, INFINITE);
+    DWORD code = 1;
+    GetExitCodeProcess(pi.hProcess, &code);
+    CloseHandle(pi.hProcess);
+    CloseHandle(pi.hThread);
+    return (int)code;
+#else
+    FILE *p = popen(cmd, "r");
+    if (!p) return -1;
+    size_t used = 0;
+    char buf[512];
+    size_t got;
+    while ((got = fread(buf, 1, sizeof(buf), p)) > 0) {
+        if (out && used + 1 < n) {
+            size_t c = got < n - 1 - used ? got : n - 1 - used;
+            memcpy(out + used, buf, c);
+            used += c;
+            out[used] = '\0';
+        }
+    }
+    int rc = pclose(p);
+    return WIFEXITED(rc) ? WEXITSTATUS(rc) : -1;
+#endif
+}
+
+/* ------------------------------------------------------------------ */
+/* Desktop                                                             */
+/* ------------------------------------------------------------------ */
+int plat_open_uri(const char *what) {
+#ifdef _WIN32
+    char w[2048];
+    snprintf(w, sizeof(w), "%s", what);
+    if (strncmp(w, "http", 4) != 0) for (char *p = w; *p; p++) if (*p == '/') *p = '\\';
+    HINSTANCE r = ShellExecuteA(NULL, "open", w, NULL, NULL, SW_SHOWNORMAL);
+    return (INT_PTR)r > 32 ? 0 : -1;
+#else
+    const char *argv[] = { "xdg-open", what, NULL };
+    return plat_spawn(argv, NULL, false, true) > 0 ? 0 : -1;
+#endif
+}
+
+void plat_keep_awake(bool on) {
+#ifdef _WIN32
+    SetThreadExecutionState(on ? (ES_CONTINUOUS | ES_SYSTEM_REQUIRED | ES_AWAYMODE_REQUIRED) : ES_CONTINUOUS);
+#else
+    (void)on;   /* Linux boxes used for this normally don't sleep; see README */
+#endif
+}
+
+char *plat_strcasestr(const char *h, const char *n) {
+    size_t L = strlen(n);
+    if (!L) return (char *)h;
+    for (; *h; h++) {
+        size_t i = 0;
+        while (i < L && h[i] && tolower((unsigned char)h[i]) == tolower((unsigned char)n[i])) i++;
+        if (i == L) return (char *)h;
+    }
+    return NULL;
+}
