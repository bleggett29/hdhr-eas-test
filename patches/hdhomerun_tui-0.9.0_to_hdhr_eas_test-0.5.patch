+    g_string_append_printf(g, "Segments %d s, ATSC 3.0 format %s\nOutput: %s\n\nTuners:\n", A.cfg.seg,
+                           A.cfg.fmt3 == EAS_FMT_DBG ? "debug" : "ALP-PCAP", A.cfg.outdir);
+    for (int i = 0; i < A.cfg.ntuners; i++)
