+    gui_confirm(title,
+                "This frees the tuner: it clears its lock, stops its stream and sets its channel to none. "
+                "Anything using it - live viewing, a capture, RabbitEars bandscan, a DVR - loses it.",
+                "Release", release_confirmed, a);
