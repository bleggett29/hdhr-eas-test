+}
+
+/* A list to pick from (programs, channel maps). */
+typedef struct {
+    GtkWidget *win, *list;
+    void (*cb)(int index, gpointer data);
+    gpointer data;
+} PickCtx;
+
+static void pick_ok(GtkWidget *w, gpointer user) {
